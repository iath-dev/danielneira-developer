---
import SocialLinks from '@/components/shared/social-links.astro';
import { fetchContent } from '@/services/data';

const socialLinks = await fetchContent.socialLinks();
---

<div class="hero from-base-300 min-h-screen bg-linear-to-b to-transparent">
  <div class="hero-content items-center text-center">
    <div class="flex max-w-lg flex-col gap-3.5">
      <h1 class="font-mono text-4xl font-bold">Jesus Daniel Neira Lara</h1>
      <h2 class="text-secondary/75 font-mono text-3xl font-bold">
        Full Stack Developer
      </h2>
      <p class="py-6">
        Building scalable web and mobile solutions with microservices, cloud
        computing, and solid coding principles.
      </p>
      <div class="flex w-full items-start">
        <SocialLinks socialLinks={socialLinks} />
      </div>
      <div class="flex items-center justify-start">
        <a
          href="/cv/FullStack Developer ENG, CV Jesus Neira.pdf"
          download
          class="btn btn-secondary btn-lg not-[hover]:btn-outline"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            class="size-[1.2em]"
            ><path fill="currentColor" d="M5 20h14v-2H5m14-9h-4V3H9v6H5l7 7z"
            ></path></svg
          >
          <span> Resume </span>
        </a>
      </div>
    </div>
    <img
      src="/images/illustration.png"
      alt="illustration"
      class="hidden w-[min(24rem,100%)] lg:flex"
    />
  </div>
</div>
