---
// Navbar.astro
---

<nav class="bg-base-100 sticky top-0 w-full">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between p-4">
    <a href="/" class="btn btn-ghost btn-square">
      <img
        src="/favicon.svg"
        alt="app icon"
        class="h-12 w-12 invert dark:invert-0"
      />
    </a>

    <!-- Botón hamburguesa mobile -->
    <button
      id="hamburger"
      class="btn btn-square btn-ghost focus:outline-none sm:hidden"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Menu desktop -->
    <div class="hidden space-x-4 sm:flex">
      <a href="/#about" class="btn btn-ghost">About</a>
      <a href="/projects" class="btn btn-ghost">Projects</a>
    </div>
  </div>

  <!-- Sidebar mobile -->
  <div
    id="mobile-menu"
    class="bg-base-300 fixed top-0 left-0 z-10 h-full w-64 -translate-x-full transition-transform duration-300 sm:hidden"
  >
    <div class="mt-16 flex flex-col space-y-4 p-4">
      <a href="/" class="hover:bg-base-100 rounded px-3 py-2">Home</a>
      <a href="/#about" class="hover:bg-base-100 rounded px-3 py-2">About</a>
      <a href="/projects" class="hover:bg-base-100 rounded px-3 py-2"
        >Projects</a
      >
    </div>
  </div>
</nav>

<script type="module">
  const btn = document.getElementById('hamburger');
  const menu = document.getElementById('mobile-menu');
  btn.addEventListener('click', () => {
    menu.classList.toggle('-translate-x-full');
  });
</script>
